// Prisma Schema for Webapp Template
// Includes Better Auth tables and multi-tenant organization support

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// BETTER AUTH MODELS
// These models are required by Better Auth
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Passwords live on Account rows (providerId 'credential'), hashed by Better
  // Auth. There is deliberately no password column here: a User.hashedPassword
  // field existed once, nothing ever read it, and the seed writing to it meant
  // no seeded account could sign in.

  // Role and permissions (user | admin)
  role          String    @default("user")

  // Admin plugin fields for user management
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  // Relations
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]
  memberships   OrganizationMember[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Written by Better Auth's organization plugin. This is the tenant scope
  // for the request: every access-control decision reads it. Without the
  // column the plugin's setActive call fails and admins cannot scope.
  activeOrganizationId String?

  // Written by Better Auth's admin plugin when an admin impersonates a user.
  // Its presence is what the ImpersonationBanner keys off.
  impersonatedBy String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String

  // Required by Better Auth >= 1.7. For OAuth this is the provider's real
  // issuer; for email/password it is the synthetic `local:credential`.
  // Sign-in matches on (providerId, issuer, accountId) — all three — so a row
  // without an issuer is invisible to the credential provider and the user is
  // reported as not found even though the row exists and the hash is correct.
  issuer                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth's canonical uniqueness is (issuer, accountId): the same
  // accountId can legitimately recur across issuers.
  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
  @@index([userId])
  @@index([expiresAt])
  @@map("verifications")
}

// =============================================================================
// ORGANIZATION MODELS
// Multi-tenant organization support with RBAC
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe customer for org-level billing, set at first checkout.
  stripeCustomerId String? @unique

  // Free-trial expiry. An org with `now < trialEndsAt` counts as active even
  // with no Subscription row, which is what lets a new tenant use the product
  // before entering a card. Null means "no trial" -- not "infinite trial".
  trialEndsAt DateTime?

  members      OrganizationMember[]
  invitations  OrganizationInvitation[]
  projects     Project[]
  subscription Subscription?
  usageRecords UsageRecord[]
  domains      OrganizationDomain[]
  activeSessions Session[]

  @@index([slug])
  @@index([stripeCustomerId])
  @@map("organizations")
}

/// Email domains that map to an organization. A user signing up with a
/// matching address is auto-joined to that org, which is how tenants get
/// populated without an invite for every employee. `domain` is globally
/// unique: one domain cannot resolve to two tenants, or signup would have to
/// guess which one the user meant.
model OrganizationDomain {
  id             String   @id @default(cuid())
  organizationId String
  domain         String   @unique
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@map("organization_domains")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("member") // owner | admin | member
  invitedBy      String
  expiresAt      DateTime
  status         String   @default("pending") // pending | accepted | rejected | expired
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

// =============================================================================
// BILLING MODELS
// Stripe-based subscription billing linked to organizations
// =============================================================================

model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("inactive") // active | trialing | past_due | canceled | unpaid | inactive
  plan                 String    @default("free") // free | pro | enterprise
  billingInterval      String?   // monthly | yearly
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String   // e.g. "api_calls", "storage_bytes", "ai_tokens"
  quantity       Int
  timestamp      DateTime @default(now())
  metadata       Json?    // optional context (endpoint, user, etc.)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric])
  @@index([organizationId, metric, timestamp])
  @@index([timestamp])
  @@map("usage_records")
}

// =============================================================================
// AUDIT LOG
// Tracks admin actions for compliance and security review
// =============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // approve | reject | ban | unban | update | delete
  entityType String   // user | organization | project
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// EXAMPLE DOMAIN MODELS
// Demonstrate application-specific tables and patterns
// =============================================================================

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  organizationId String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId])
  @@index([createdBy])
  @@map("projects")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  status      String   @default("todo") // todo | in_progress | done
  priority    String   @default("medium") // low | medium | high
  projectId   String
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dueDate     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}
